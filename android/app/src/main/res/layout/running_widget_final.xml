<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#120E15">

    <!-- INCREMENT AREA (Matches parent) -->
    <LinearLayout
        android:id="@+id/widget_increment_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/today_miles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#D93846"
            android:textSize="64sp"
            android:textStyle="bold" />
            
        <TextView
            android:id="@+id/miles_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MILES"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
    
    <!-- TITLE AREA (For opening app) -->
    <TextView
        android:id="@+id/day_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TODAY"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        android:gravity="center_horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- REFRESH ICON -->
    <ImageView
        android:id="@+id/widget_refresh"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:padding="6dp"
        android:src="@drawable/ic_refresh"
        android:contentDescription="Refresh Widget"
        android:clickable="true"
        android:focusable="true" />
</FrameLayout>
