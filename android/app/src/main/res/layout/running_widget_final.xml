<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#120E15"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- HEADER: TITLE AND TOTAL -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RUNNING LOG"
            android:textColor="#AAAAAA"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.2" />

        <TextView
            android:id="@+id/total_miles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:text="0 mi"
            android:textColor="#D93846"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- DAY ROWS -->
    <!-- ROW 0: MON -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/btn_dec_0" android:layout_width="45dp" android:layout_height="match_parent" android:text="MON" android:textColor="#888888" android:textSize="10sp" android:textStyle="bold" android:gravity="center_vertical" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/btn_inc_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text=" " android:textColor="#D93846" android:textSize="16sp" android:letterSpacing="0.1" android:gravity="center_vertical" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/text_miles_0" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="" android:textColor="#AAAAAA" android:textSize="10sp" android:textStyle="bold" android:gravity="center_vertical" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/btn_dec_1" android:layout_width="45dp" android:layout_height="match_parent" android:text="TUE" android:textColor="#888888" android:textSize="10sp" android:textStyle="bold" android:gravity="center_vertical" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/btn_inc_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text=" " android:textColor="#D93846" android:textSize="16sp" android:letterSpacing="0.1" android:gravity="center_vertical" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/text_miles_1" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="" android:textColor="#AAAAAA" android:textSize="10sp" android:textStyle="bold" android:gravity="center_vertical" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/btn_dec_2" android:layout_width="45dp" android:layout_height="match_parent" android:text="WED" android:textColor="#888888" android:textSize="10sp" android:textStyle="bold" android:gravity="center_vertical" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/btn_inc_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text=" " android:textColor="#D93846" android:textSize="16sp" android:letterSpacing="0.1" android:gravity="center_vertical" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/text_miles_2" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="" android:textColor="#AAAAAA" android:textSize="10sp" android:textStyle="bold" android:gravity="center_vertical" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/btn_dec_3" android:layout_width="45dp" android:layout_height="match_parent" android:text="THU" android:textColor="#888888" android:textSize="10sp" android:textStyle="bold" android:gravity="center_vertical" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/btn_inc_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text=" " android:textColor="#D93846" android:textSize="16sp" android:letterSpacing="0.1" android:gravity="center_vertical" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/text_miles_3" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="" android:textColor="#AAAAAA" android:textSize="10sp" android:textStyle="bold" android:gravity="center_vertical" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/btn_dec_4" android:layout_width="45dp" android:layout_height="match_parent" android:text="FRI" android:textColor="#888888" android:textSize="10sp" android:textStyle="bold" android:gravity="center_vertical" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/btn_inc_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text=" " android:textColor="#D93846" android:textSize="16sp" android:letterSpacing="0.1" android:gravity="center_vertical" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/text_miles_4" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="" android:textColor="#AAAAAA" android:textSize="10sp" android:textStyle="bold" android:gravity="center_vertical" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/btn_dec_5" android:layout_width="45dp" android:layout_height="match_parent" android:text="SAT" android:textColor="#888888" android:textSize="10sp" android:textStyle="bold" android:gravity="center_vertical" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/btn_inc_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text=" " android:textColor="#D93846" android:textSize="16sp" android:letterSpacing="0.1" android:gravity="center_vertical" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/text_miles_5" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="" android:textColor="#AAAAAA" android:textSize="10sp" android:textStyle="bold" android:gravity="center_vertical" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/btn_dec_6" android:layout_width="45dp" android:layout_height="match_parent" android:text="SUN" android:textColor="#888888" android:textSize="10sp" android:textStyle="bold" android:gravity="center_vertical" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/btn_inc_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text=" " android:textColor="#D93846" android:textSize="16sp" android:letterSpacing="0.1" android:gravity="center_vertical" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/text_miles_6" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="" android:textColor="#AAAAAA" android:textSize="10sp" android:textStyle="bold" android:gravity="center_vertical" />
    </LinearLayout>

</LinearLayout>
